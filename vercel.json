{
  "version": 2,
  "name": "nitro-delivery-platform",
  "builds": [
    {
      "src": "index.html",
      "use": "@vercel/static",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/$1"
    }
  ],
  "env": {
    "VITE_API_URL": "@api_url",
    "VITE_GOOGLE_MAPS_API_KEY": "@google_maps_api_key"
  },
  "build": {
    "env": {
      "VITE_API_URL": "@api_url",
      "VITE_GOOGLE_MAPS_API_KEY": "@google_maps_api_key"
    }
  },
  "regions": ["cdg1"],
  "functions": {
    "app/api/server.js": {
      "runtime": "nodejs18.x"
    }
  }
}
